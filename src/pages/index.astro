---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import { featuredCategorySlugs } from '../data/site';
import {
  excerptText,
  getAllPosts,
  getCategories,
  getFeaturedImage,
  getPrimaryCategory,
  htmlToText,
  legacyPath
} from '../lib/wordpress';

const PAGE_SIZE = 12;
const [posts, allCategories] = await Promise.all([getAllPosts(), getCategories()]);
const [lead, ...rest] = posts;
const leadImage = getFeaturedImage(lead);
const latest = posts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const featuredCategories = featuredCategorySlugs
  .map((slug) => allCategories.find((category) => category.slug === slug))
  .filter(Boolean);
---
<BaseLayout title="BitcoinVersus.tech — Smart News Daily" description="Bitcoin mining, power efficiency, AI, data centers, semiconductors, energy, electrical engineering, and technical documentation.">
  <section class="hero">
    <article class:list={['lead', { 'has-image': Boolean(leadImage) }]}>
      {leadImage && <img class="lead-visual" src={leadImage.src} alt={leadImage.alt} loading="eager" decoding="async" />}
      <div class="lead-copy">
        <div class="eyebrow">{getPrimaryCategory(lead)?.name ?? 'Latest'}</div>
        <h1><a href={legacyPath(lead)}>{htmlToText(lead.title.rendered)}</a></h1>
        <p>{excerptText(lead)}</p>
      </div>
    </article>
    <aside class="panel" aria-label="Top stories">
      <div class="eyebrow">Top Stories</div>
      <div class="stack">
        {rest.slice(0, 5).map((post) => (
          <article class="mini-story">
            <div class="meta">{getPrimaryCategory(post)?.name ?? 'Latest'}</div>
            <h3><a href={legacyPath(post)}>{htmlToText(post.title.rendered)}</a></h3>
          </article>
        ))}
      </div>
    </aside>
  </section>

  <div class="section-head">
    <h2>Latest</h2>
    <p>Research, field documentation, and consequential technology news.</p>
  </div>
  <section class="grid" aria-label="Latest stories">
    {latest.map((post) => <StoryCard post={post} />)}
  </section>
  {totalPages > 1 && (
    <nav class="pagination" aria-label="Publication pagination">
      <span>Page 1 of {totalPages}</span>
      <a href="/page/2">Older stories →</a>
    </nav>
  )}

  <div class="section-head">
    <h2>Explore the publication</h2>
    <p>Focused sections backed by the full BitcoinVersus archive.</p>
  </div>
  <section class="grid" aria-label="Publication categories">
    {featuredCategories.map((category) => category && (
      <a class="category-card" href={`/category/${category.slug}`}>
        <div class="eyebrow">{category.count} posts</div>
        <h3>{category.name}</h3>
        <p>{category.description || `Browse the latest ${category.name} reporting and technical research.`}</p>
      </a>
    ))}
  </section>
</BaseLayout>
