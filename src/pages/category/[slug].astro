---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { excerptText, getAllPosts, getCategories, htmlToText, legacyPath } from '../../lib/wordpress';

const PAGE_SIZE = 24;

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const posts = (await getAllPosts()).filter((post) => post.categories.includes(category.id));
const visiblePosts = posts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---
<BaseLayout title={`${category.name} — BitcoinVersus.tech`} description={category.description || `Latest ${category.name} reporting and technical research from BitcoinVersus.tech.`}>
  <div class="eyebrow">Section · {posts.length} posts</div>
  <div class="section-head">
    <h1>{category.name}</h1>
    <p>{category.description || `Browse ${category.name} reporting, research, and technical documentation.`}</p>
  </div>
  <section class="grid">
    {visiblePosts.map((post) => (
      <article class="story-card">
        <h3><a href={legacyPath(post)}>{htmlToText(post.title.rendered)}</a></h3>
        <p>{excerptText(post)}</p>
        <div class="meta"><time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time></div>
      </article>
    ))}
  </section>
  {totalPages > 1 && (
    <nav class="pagination" aria-label="Category pagination">
      <span>Page 1 of {totalPages}</span>
      <a href={`/category/${category.slug}/page/2`}>Older stories →</a>
    </nav>
  )}
</BaseLayout>
