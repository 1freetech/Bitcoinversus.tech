---
import type { WPPost } from '../lib/wordpress';
import { excerptText, getFeaturedImage, getPrimaryCategory, htmlToText, legacyPath } from '../lib/wordpress';

const { post, showCategory = true } = Astro.props as { post: WPPost; showCategory?: boolean };
const image = getFeaturedImage(post);
const category = getPrimaryCategory(post);
const href = legacyPath(post);
---
<article class="story-card">
  {image && (
    <a class="story-thumb" href={href} tabindex="-1" aria-hidden="true">
      <img src={image.src} alt="" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="story-card-body">
    {showCategory && <div class="eyebrow">{category?.name ?? 'Latest'}</div>}
    <h3><a href={href}>{htmlToText(post.title.rendered)}</a></h3>
    <p>{excerptText(post)}</p>
    <div class="meta"><time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time></div>
  </div>
</article>
