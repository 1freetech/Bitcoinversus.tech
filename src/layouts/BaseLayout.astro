---
import '../styles/global.css';
import { nav } from '../data/site';
const {
  title = 'BitcoinVersus.tech',
  description = 'Smart news and technical research for Bitcoiners, infrastructure operators, and engineers.',
  canonical = Astro.url.pathname,
  image,
  ogType = 'website',
  published,
  modified
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://bitcoinversus.tech');
const canonicalUrl = new URL(canonical, siteUrl).toString();
const imageUrl = image ? new URL(image, siteUrl).toString() : undefined;
const schema = ogType === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: title.replace(/ — BitcoinVersus\.tech$/, ''),
      description,
      url: canonicalUrl,
      datePublished: published,
      dateModified: modified ?? published,
      image: imageUrl ? [imageUrl] : undefined,
      publisher: { '@type': 'Organization', name: 'BitcoinVersus.tech', url: 'https://bitcoinversus.tech' }
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'BitcoinVersus.tech',
      url: 'https://bitcoinversus.tech',
      description
    };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#050806" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="BitcoinVersus.tech RSS" href="/rss.xml" />
    <meta property="og:site_name" content="BitcoinVersus.tech" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="/" aria-label="BitcoinVersus.tech home">bitcoinversus<span>.tech</span></a>
        <nav class="nav" aria-label="Primary navigation">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main class="shell page" id="content"><slot /></main>
    <footer>
      <div class="shell footer-row">
        <div><strong>bitcoinversus.tech</strong> · Smart News Daily</div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/about">About</a>
          <a href="/rss.xml">RSS</a>
          <a href="/sitemap.xml">Sitemap</a>
        </nav>
        <div>Verifiably True research · Informational only · Not financial advice.</div>
      </div>
    </footer>
  </body>
</html>
